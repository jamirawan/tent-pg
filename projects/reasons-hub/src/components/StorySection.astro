---
export interface StoryItem {
  num: string;
  text: string;
}

export interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  hint: string;
  items: StoryItem[];
}

const { id, eyebrow, heading, hint, items } = Astro.props;
---

<section class="story" id={id}>
  <div class="story-sticky">
    <span class="story-label">{eyebrow}</span>
    <h2>{heading}</h2>
    <span class="story-hint">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M12 5v14M5 12l7 7 7-7" />
      </svg>
      {hint}
    </span>
  </div>
  <div class="story-copy" tabindex="0" aria-label={`${heading}, scrollable`}>
    {items.map((item) => (
      <div class="story-item">
        <span class="story-num">{item.num}</span>
        <p set:html={item.text} />
      </div>
    ))}
  </div>
</section>

<style>
  .story{
    max-width:1280px; margin:0 auto;
    padding:6.5rem 1.5rem;
    display:grid; gap:2.5rem;
  }
  .story-sticky{ position:sticky; top:7rem; align-self:start; max-width:56rem; }
  .story-sticky h2{
    font-size:clamp(2rem, 3.2vw, 2.8rem);
    font-weight:900; line-height:1.08; letter-spacing:-.01em;
    margin-top:1rem; color:var(--navy-deep);
  }
  .story-sticky .story-hint{
    display:flex; align-items:center; gap:.5rem;
    margin-top:1.6rem;
    font-family:'JetBrains Mono', monospace;
    font-size:.72rem; letter-spacing:.1em; text-transform:uppercase;
    color:#8a84a8;
  }
  .story-sticky .story-hint svg{ width:14px; height:14px; animation:bob 1.6s ease-in-out infinite; }
  @keyframes bob{ 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(4px); } }
  @media (prefers-reduced-motion: reduce){ .story-sticky .story-hint svg{ animation:none; } }

  /* scrollable paragraph column: fixed 80vh viewport, content scrolls within it */
  .story-copy{
    height:80vh;
    overflow-y:auto;
    overscroll-behavior:contain;
    padding-right:1.5rem;
    scrollbar-width:thin;
    scrollbar-color:var(--ochre) transparent;
    -webkit-mask-image:linear-gradient(to bottom, transparent 0, black 24px, black calc(100% - 24px), transparent 100%);
            mask-image:linear-gradient(to bottom, transparent 0, black 24px, black calc(100% - 24px), transparent 100%);
  }
  .story-copy::-webkit-scrollbar{ width:6px; }
  .story-copy::-webkit-scrollbar-thumb{ background:var(--ochre); border-radius:3px; }
  .story-copy::-webkit-scrollbar-track{ background:transparent; }

  .story-item{
    display:flex; gap:1.4rem;
    padding:1.7rem 0;
    border-bottom:1px solid var(--line);
  }
  .story-item:first-child{ padding-top:.3rem; }
  .story-item:last-child{ border-bottom:0; padding-bottom:2rem; }
  .story-num{
    flex-shrink:0;
    font-family:'JetBrains Mono', monospace;
    font-weight:700; font-size:.85rem;
    color:var(--ochre);
    padding-top:.15rem;
    min-width:2.2rem;
  }
  .story-item p{
    font-size:1.08rem; line-height:1.65; color:#3a3654;
    max-width:52ch;
  }
  .story-item p :global(strong){ color:var(--navy-deep); font-weight:600; }

  @media (max-width: 860px){
    .story{ gap:2rem; }
    .story-sticky{ position:static; }
    .story-copy{ height:60vh; }
  }
</style>
