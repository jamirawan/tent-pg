---
export interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref?: string;
}

const { eyebrow, heading, body, ctaLabel, ctaHref = '#' } = Astro.props;
---

<section class="banner-top">
  <div class="banner-top-content">
    <span class="story-label">{eyebrow}</span>
    <h2>{heading}</h2>
    <p>{body}</p>
    <a href={ctaHref} class="btn-primary">{ctaLabel}</a>
  </div>
</section>

<style>
  .banner-top{
    position:relative;
    min-height:70vh;
    display:flex; flex-direction:column; align-items:center;
    padding:5.5rem 1.5rem 0;
    overflow:hidden;
    background:linear-gradient(180deg, var(--navy-deep) 0%, #3a2145 45%, var(--ochre) 100%);
  }
  .banner-top::after{
    content:'';
    position:absolute; left:0; right:0; bottom:0; height:45%;
    background:
      linear-gradient(180deg, transparent, rgba(20,20,63,0.5)),
      repeating-linear-gradient(95deg, rgba(255,255,255,0.05) 0 3px, transparent 3px 70px);
  }
  .banner-top-content{
    position:relative; z-index:2;
    max-width:760px; text-align:center;
  }
  .banner-top-content :global(.story-label){ justify-content:center; color:#ffb35c; }
  .banner-top-content :global(.story-label::before){ background:#ffb35c; }
  .banner-top h2{
    color:#fff; font-weight:900;
    font-size:clamp(2.2rem, 4.6vw, 3.6rem);
    line-height:1.05; margin:1.2rem 0 1.4rem; letter-spacing:-.01em;
  }
  .banner-top p{
    color:rgba(255,255,255,0.8); font-size:1.1rem;
    max-width:46ch; margin:0 auto 2.4rem; line-height:1.6;
  }
  .btn-primary{
    background:#fff; color:var(--navy-deep);
    padding:.95rem 1.9rem; border-radius:999px;
    font-weight:700; font-size:.95rem; display:inline-block;
    transition:transform .2s ease, box-shadow .2s ease;
  }
  .btn-primary:hover{ transform:translateY(-2px); box-shadow:0 10px 24px rgba(0,0,0,0.25); }
</style>
