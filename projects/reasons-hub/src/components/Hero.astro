---
import Odometer from './Odometer.astro';
---

<section class="hero">
  <div class="hero-content">
    <Odometer
      id="ntOdometer"
      value="300"
      label="Days of sunshine every year"
      class="hero-counter-top"
    />

    <span class="hero-eyebrow">Red Centre · Year-round</span>
    <h1>Best Kept Season</h1>
    <div class="hero-actions">
      <a href="#story" class="btn-ghost">Why the Territory ↓</a>
    </div>
  </div>
</section>

<style>
  .hero{
    position:relative;
    min-height:88vh;
    display:flex; align-items:flex-end;
    overflow:hidden;
    background:
      radial-gradient(120% 100% at 85% 15%, rgba(230,99,0,0.35), transparent 55%),
      linear-gradient(180deg, #2a2a6b 0%, #7a3a2e 55%, #b5451b 100%);
  }
  .hero::before{
    /* horizon / landscape silhouette, stands in for hero photography */
    content:'';
    position:absolute; left:0; right:0; bottom:0; height:38%;
    background:
      linear-gradient(180deg, transparent, rgba(20,20,63,0.35) 40%, rgba(20,20,63,0.75) 100%),
      repeating-linear-gradient(100deg, rgba(0,0,0,0.08) 0 2px, transparent 2px 60px);
    -webkit-mask-image: linear-gradient(to top, black, transparent);
            mask-image: linear-gradient(to top, black, transparent);
  }
  .hero::after{
    content:'';
    position:absolute; inset:0;
    background-image:
      radial-gradient(2px 2px at 20% 20%, rgba(255,255,255,.5) 0, transparent 60%),
      radial-gradient(1.5px 1.5px at 65% 12%, rgba(255,255,255,.4) 0, transparent 60%),
      radial-gradient(1.5px 1.5px at 80% 30%, rgba(255,255,255,.35) 0, transparent 60%),
      radial-gradient(2px 2px at 40% 8%, rgba(255,255,255,.4) 0, transparent 60%);
    opacity:.8;
  }
  .hero-content{
    position:relative; z-index:2;
    max-width:1280px; margin:0 auto; width:100%;
    padding:0 1.5rem 5rem;
  }
  .hero-content :global(.hero-counter-top){
    
    min-width:280px;
    margin-bottom:2.6rem;
  }
  .hero-eyebrow{
    display:inline-flex; align-items:center; gap:.5rem;
    font-family:'JetBrains Mono', monospace;
    font-size:.75rem; letter-spacing:.12em; text-transform:uppercase;
    color:#ffd9ad; margin-bottom:1.5rem;
  }
  .hero-eyebrow::before{
    content:''; width:8px; height:8px; border-radius:50%;
    background:#ffb04d; box-shadow:0 0 0 4px rgba(255,176,77,0.25);
  }
  .hero h1{
    font-weight:900; color:#fff;
    font-size:clamp(2.6rem, 6vw, 5.2rem);
    line-height:0.98; letter-spacing:-.02em;
    max-width:14ch;
    margin-bottom:1.4rem;
  }
  .hero-actions{ display:flex; gap:1rem; flex-wrap:wrap; align-items:center; }
  .btn-ghost{
    color:#fff; font-weight:600; font-size:.95rem;
    display:inline-flex; align-items:center; gap:.5rem;
    border-bottom:1px solid rgba(255,255,255,0.4); padding-bottom:.2rem;
  }
</style>
