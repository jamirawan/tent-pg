---
import Odometer from './Odometer.astro';
---

<section class="hero">
  <div class="hero-content">
    <Odometer
      id="ntOdometer"
      value="300"
      label="Days of sunshine every year"
      class="hero-counter-top"
    />

    <span class="hero-eyebrow">Red Centre · Year-round</span>
    <h1>Best Kept Season</h1>
    <div class="hero-actions">
      <a href="#story" class="btn-ghost">Why the Territory ↓</a>
    </div>
  </div>
</section>

<style>
  .hero{
    position:relative;
    min-height:88vh;
    display:flex; align-items:flex-end;
    overflow:hidden;
    background:
      linear-gradient(90deg, rgba(17, 24, 39, 0.74) 0%, rgba(17, 24, 39, 0.28) 45%, rgba(17, 24, 39, 0.5) 100%),
      url('https://img2.storyblok.com/f/286255898790625/93f0cf92a6/untitled-4_-1.png') center/cover no-repeat;
  }
  .hero::before{
    content:'';
    position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.32) 100%);
    pointer-events:none;
  }
  .hero-content{
    position:relative; z-index:2;
    width:100%;
    min-height:88vh;
    display:flex; flex-direction:column; justify-content:flex-end;
    padding:0 1.5rem 5rem;
    background:linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.18) 100%);
  }
  .hero-content :global(.hero-counter-top){
    
    min-width:280px;
    margin-bottom:2.6rem;
  }
  .hero-eyebrow{
    display:inline-flex; align-items:center; gap:.5rem;
    font-family:'JetBrains Mono', monospace;
    font-size:.75rem; letter-spacing:.12em; text-transform:uppercase;
    color:#ffd9ad; margin-bottom:1.5rem;
  }
  .hero-eyebrow::before{
    content:''; width:8px; height:8px; border-radius:50%;
    background:#ffb04d; box-shadow:0 0 0 4px rgba(255,176,77,0.25);
  }
  .hero h1{
    font-weight:900; color:#fff;
    font-size:clamp(2.6rem, 6vw, 5.2rem);
    line-height:0.98; letter-spacing:-.02em;
    max-width:14ch;
    margin-bottom:1.4rem;
  }
  .hero-actions{ display:flex; gap:1rem; flex-wrap:wrap; align-items:center; }
  .btn-ghost{
    color:#fff; font-weight:600; font-size:.95rem;
    display:inline-flex; align-items:center; gap:.5rem;
    border-bottom:1px solid rgba(255,255,255,0.4); padding-bottom:.2rem;
  }
</style>
